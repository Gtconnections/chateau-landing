# Copia este archivo a .env.local y rellena tus credenciales de SendGrid.

# API Key de SendGrid (Settings > API Keys, empieza con "SG.")
SENDGRID_API_KEY=

# Remitente verificado en SendGrid (Single Sender o dominio autenticado)
SENDGRID_FROM_EMAIL=info@cupontours.com
SENDGRID_FROM_NAME=Château

# Correo interno que recibe el aviso de cada nueva inversión (lead)
SENDGRID_SEND_TO_EMAIL=info@cupontours.com
